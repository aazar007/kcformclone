# KSU Crown — environment template
#
# Copy to `.env` for local development, or set the same names in the Cloudflare
# dashboard (Settings → Variables and Secrets). `.env` is gitignored; this file is
# the documented copy and is what `npm run check` reads to tell you what is missing.
#
# Anything marked **secret** belongs in a secret store, not in a text variable:
# Cloudflare treats the two differently, and a text variable is visible to anyone
# who can open the dashboard.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# **Secret.** PostgreSQL, pooled. Use the pooled host: serverless functions open
# many short-lived connections and an unpooled URL exhausts them.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"

# ─────────────────────────────────────────────────────────────────────────────
# The organiser console
# ─────────────────────────────────────────────────────────────────────────────
# **Secret.** Derives the console's web address from a hash of its value, so
# changing it moves both URLs below. It is NOT the grand admin's password any
# more: it is accepted only as a *bootstrap* credential, on a deployment that has
# never had a password set. Set the password from the console — after that this
# value no longer signs anybody in.
ADMIN_SECRET=""

# Where the grand admin's confirmation code is sent. One or more addresses,
# separated by commas, semicolons or newlines; the first is the primary, which the
# code is hashed against. Until this is set there is no second step at all, and the
# console shows a warning saying so.
ADMIN_EMAIL=""

# Optional. Mixes a value that never reaches the database into the stored password
# hash, so a stolen dump cannot be tested against a guess. Must be the SAME value
# everywhere, and changing it invalidates the stored password (then:
# `npm run admin:reset`).
ADMIN_PEPPER=""

# Optional. Choose the console's addresses yourself instead of letting them be
# derived from ADMIN_SECRET. A value that is not usable as a path is reported and
# the derived one is used instead.
ADMIN_PATH=""
STAFF_PATH=""

# ─────────────────────────────────────────────────────────────────────────────
# One-time codes and their signatures
# ─────────────────────────────────────────────────────────────────────────────
# **Secret.** Signs the proofs that say an email address was verified. Generate it
# with any of these, and paste the OUTPUT, never the command:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
#
# Without it, no verification code can be issued and registration cannot complete.
OTP_SECRET=""

# Optional. Caps how many codes may be issued site-wide in one window, as a defence
# against an attacker who changes the address every time. Defaults to 300. Leave
# empty unless you have a reason.
OTP_GLOBAL_MAX=""

# Development only — ignored in production. Skips the emailed code entirely so the
# app is usable before a sending account exists.
OTP_SKIP_VERIFY=""

# ─────────────────────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────────────────────
# Two channels, and each setting falls back to the shared SMTP_* value:
#
#   SMTP_OTP_*           verification codes
#   SMTP_CONFIRMATION_*  registration confirmations
#
# Separating them is deliberate: a code should not arrive from the same mailbox
# that sends announcements, or it reads as a forgery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
# **Secret.** Taken literally — surrounding spaces are preserved, and Gmail app
# passwords are commonly displayed with spaces inside them.
SMTP_PASS=""
# A display name is fine here; the authenticated user is borrowed as the address.
SMTP_FROM="KSU Crown"
MAIL_REPLY_TO=""

# Per-channel overrides. Any value left blank falls back to the shared setting.
SMTP_OTP_HOST=""
SMTP_OTP_PORT=""
SMTP_OTP_USER=""
SMTP_OTP_PASS=""
SMTP_OTP_FROM=""
SMTP_CONFIRMATION_HOST=""
SMTP_CONFIRMATION_PORT=""
SMTP_CONFIRMATION_USER=""
SMTP_CONFIRMATION_PASS=""
SMTP_CONFIRMATION_FROM=""
SMTP_CONFIRMATION_REPLY_TO=""

# ─────────────────────────────────────────────────────────────────────────────
# Addresses
# ─────────────────────────────────────────────────────────────────────────────
# The canonical public address, used to build absolute links and inline images in
# email. Without it the request's own origin is used, which is right for a preview
# and wrong for a production mail.
APP_URL=""
NEXT_PUBLIC_APP_URL=""

# ⚠️ REQUIRED on any deployment that is not on Cloudflare or Vercel, or per-client
# rate limits stop being per-client. They are keyed by the caller's address, and the
# address can only come from the proxy: set this to the header YOUR proxy
# overwrites, never one it merely forwards.
#
#   TRUSTED_IP_HEADER="x-real-ip"
#
# Left empty, every caller shares one bucket — safe, but site-wide.
TRUSTED_IP_HEADER=""

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheet export (optional)
# ─────────────────────────────────────────────────────────────────────────────
# The Apps Script web app that the database is mirrored into, and the shared secret
# that proves the request came from this deployment.
SHEET_WEBHOOK_URL=""
# **Secret.**
SHEET_WEBHOOK_SECRET=""
# The spreadsheet the organiser clicks through to. Only shown in the console.
SHEET_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Security extras (optional)
# ─────────────────────────────────────────────────────────────────────────────
# RFC 9116 disclosure contact. `/.well-known/security.txt` answers 404 until this is
# a `mailto:` or `https://` address somebody actually monitors.
SECURITY_CONTACT=""
# When that file expires. Defaults to one year from the request.
SECURITY_EXPIRES=""

# Set to 0 only to fall back to the looser Content-Security-Policy in
# next.config.mjs. The strict policy is built per request with a nonce.
CSP_STRICT=""
