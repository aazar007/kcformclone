// KSU Crown — registration database.
//
// Replaces the Google Sheets backend that used to be the only store. The sheet
// is still available as an *export* (see /api/admin/export/sheets) but Prisma is
// the source of truth: it is what makes unique team names, OTP verification and
// self-service edits possible.
//
// Local development and production both point at PostgreSQL (Vercel Postgres /
// Neon in production) — see DATABASE_URL in .env.

// `prisma-client` with runtime "workerd" is required on Cloudflare Workers: it
// loads the query engine as a precompiled WebAssembly module. The older
// `prisma-client-js` compiles it from base64 at run time, which Workers refuse
// ("Wasm code generation disallowed by embedder"). The client is generated into
// generated/prisma-client (gitignored) by `postinstall` and imported by src/lib/db.ts.
// Two clients from one schema, because one binary cannot serve both runtimes.
//
// `runtime = "workerd"` makes Prisma load its query compiler as
// `query_compiler_fast_bg.wasm?module`. That `?module` suffix is a **Cloudflare
// Workers** import convention: Wrangler resolves it, and nothing else can. On Node
// — which is what Vercel, `next start`, and every `scripts/*.ts` run on — the import
// fails and the client constructor throws
//   "The loaded wasm module was unexpectedly `undefined` or `null` once loaded"
// so every database call answers "cannot be reached", whatever `DATABASE_URL` says.
// That is why editing the URL changed nothing.
//
// So both are generated, and `npm run prisma:node` / `npm run prisma:workers` copies
// the one the current target needs into `generated/prisma-client`. The application
// imports that single path and never has to know which flavour won.
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma-client-node"
  moduleFormat = "esm"
}

generator clientWorkers {
  provider     = "prisma-client"
  output       = "../generated/prisma-client-workers"
  runtime      = "workerd"
  moduleFormat = "esm"
}

// Prisma 7 moved the connection URL out of the schema: it now lives in
// prisma.config.ts for the CLI (migrate/generate) and in the driver adapter
// passed to `new PrismaClient()` at runtime. See src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// One team registration. `reference` is the code the team keeps and uses to
/// return and edit their entry.
model Team {
  id             String   @id @default(cuid())
  reference      String   @unique
  /// The display name, always normalised to start with "Team".
  teamName       String
  /// Lower-cased, whitespace-collapsed name. This is the unique key, so two
  /// teams cannot register the same name in different casing.
  teamNameKey    String   @unique
  tournamentName String
  /// "male" | "female"
  gender         String
  gameId         String
  gameName       String
  leaderIndex    Int      @default(0)
  /// When the captain confirmed they had read the privacy notice and that every
  /// member knows their details are shared. NULL means consent was not required
  /// when this entry was made, which is why it is nullable rather than defaulted:
  /// inventing a timestamp would fabricate a decision nobody made.
  consentedAt    DateTime?
  /// When an organiser banned this team, or NULL while it is active. A banned
  /// team can still be read in the console, but cannot be edited by its captain
  /// and none of its members may be re-registered elsewhere.
  bannedAt       DateTime?
  /// Why it was banned, in the organiser's words. Empty when not banned.
  banReason      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members Member[]

  @@index([gameId])
  @@index([gender])
  @@index([createdAt])
}

/// One roster slot — a player, a substitute or a coach.
model Member {
  id               String @id @default(cuid())
  teamId           String
  team             Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Position within the roster, in the order the captain entered it.
  position         Int
  fullName         String
  /// In-game handle. Empty for coaches, who need not have one.
  gameTag          String @default("")
  universityId     String
  universityName   String
  universityRegion String
  /// Globally unique: the same address cannot join two teams.
  email            String @unique
  /// Null for coaches, who need not be students. Nullable so the unique index
  /// tolerates many of them — PostgreSQL allows repeated NULLs.
  studentId        String? @unique
  discord          String
  phone            String
  /// "STARTER" | "SUBSTITUTE" | "COACH"
  role             String @default("STARTER")
  /// Organiser-defined answers, stored as [{ id, label, value }].
  requirements     Json   @default("[]")
  /// When this member proved they own the address, by entering the emailed code
  /// (the team leader) or by completing the emailed details form (everyone
  /// else). NULL on a non-leader means the address is still pending confirmation.
  emailConfirmedAt DateTime?
  /// When the member filled in their own details from their emailed link.
  ///
  /// The captain only enters a teammate's university and email, so a non-leader
  /// row is created incomplete: name, game tag, student ID, contacts and the
  /// organiser's questions are theirs to supply. A leader row is complete from
  /// the start. NULL therefore means "waiting for the player", which is what the
  /// console shows as pending.
  profileCompletedAt DateTime?
  /// When an organiser banned this member, or NULL while they are active. A
  /// banned member is refused in any new registration and cannot use their
  /// details link.
  bannedAt         DateTime?
  /// Why they were banned, in the organiser's words.
  banReason        String   @default("")
  /// SHA-256 hash of the single-use confirmation link token. Only the hash is
  /// stored, so a leaked database cannot be used to confirm somebody's address.
  confirmTokenHash String? @unique
  createdAt        DateTime @default(now())

  @@unique([teamId, position])
  @@index([teamId])
}

/// A registration in progress.
///
/// The captain finishes the roster and, before anything is submitted, every
/// teammate is emailed a link to add their own details. Those answers have to be
/// stored somewhere the moment they arrive — the captain's review step shows them
/// live — and there is no `Team` row yet, because nothing has been submitted and
/// the team name must not be reserved by an abandoned attempt.
///
/// So a draft is its own small record: the team facts already chosen, and one row
/// per teammate. Submitting turns it into a `Team` and deletes it.
model Draft {
  id             String   @id @default(cuid())
  /// SHA-256 of the value the browser holds. The browser is given the raw secret
  /// once; only its hash is stored, so a database leak cannot open somebody's draft.
  secretHash     String   @unique
  teamName       String
  tournamentName String
  gameName       String
  gender         String
  /// Position of the leader, so a player completing their form is not asked to be
  /// a leader and a leader is never sent a completion link.
  leaderIndex    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members DraftMember[]

  @@index([createdAt])
  /// The sweeper deletes on `updatedAt`, which is the only thing that moves while a
  /// teammate is filling their form in.
  @@index([updatedAt])
}

/// One teammate as they will appear on the roster, filled in by that person.
///
/// The captain supplied only the role, university and address; the rest arrives
/// from the emailed link. `profileCompletedAt` is when they submitted it, and is
/// also when their address counts as confirmed — the link itself proved the
/// mailbox.
model DraftMember {
  id                 String    @id @default(cuid())
  draftId            String
  draft              Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  position           Int
  role               String    @default("STARTER")
  universityId       String
  universityName     String
  universityRegion   String
  email              String
  fullName           String    @default("")
  gameTag            String    @default("")
  studentId          String?
  discord            String    @default("")
  phone              String    @default("")
  requirements       Json      @default("[]")
  profileCompletedAt DateTime?
  /// SHA-256 of the completion link token. Only the hash is stored.
  confirmTokenHash   String?   @unique
  createdAt          DateTime  @default(now())

  @@unique([draftId, position])
  @@index([draftId])
}

/// The tournament settings the organiser edits in the admin console. A single
/// row (id = 1) whose `data` is the normalised TournamentConfig.
model Config {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

/// A one-time passcode. Only the hash is stored, so a database leak does not
/// hand over working codes.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  /// "player-email" verifies a roster member; "edit-access" unlocks self-service editing.
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  /// Supports the site-wide ceiling (`countAllRecentOtps`), which filters on both columns.
  /// That count runs on a public endpoint, so without this index an abuse-control check
  /// would itself become the expensive thing to call.
  @@index([purpose, createdAt])
}

/// A game logo, validated to a fixed square size before it is stored. Bytes live
/// in the database because Vercel's filesystem is ephemeral, and are served back
/// through /api/games/[gameId]/logo.
model GameLogo {
  gameId    String   @id
  mimeType  String
  width     Int
  height    Int
  size      Int
  bytes     Bytes
  updatedAt DateTime @updatedAt
}

/// A sponsor's logo, stored exactly like a game's.
///
/// Keyed by the sponsor's id — the slug in `Config.sponsors[].id` — rather than by a
/// foreign key, because sponsors live inside the config JSON. That means deleting a
/// sponsor from the config leaves its bytes behind; `pruneSponsorLogos` sweeps those up
/// when the console saves, which is cheaper and safer than a cascade across a JSON
/// column that PostgreSQL cannot follow.
model SponsorLogo {
  sponsorId String   @id
  mimeType  String
  width     Int
  height    Int
  size      Int
  bytes     Bytes
  updatedAt DateTime @updatedAt
}

/// Someone the grand admin has granted access to the organiser console.
///
/// The grand admin is not a row here: they hold `ADMIN_SECRET`, which is a
/// deployment secret rather than data, so it cannot be granted away from a web
/// form or leaked by reading this table. This table is only the list of *other*
/// people, and it is what an emailed code is checked against — an address that is
/// not here never receives a code and can never sign in.
model StaffAccess {
  id          String    @id @default(cuid())
  /// Lower-cased on the way in. The identity of the grant: two rows differing
  /// only in case would be the same person with two grants.
  email       String    @unique
  /// Why this person has access, in the grand admin's words. Shown back to them
  /// so a year-old grant is not a mystery.
  note        String    @default("")
  addedAt     DateTime  @default(now())
  /// Last time they completed a sign-in, so an unused grant is visible.
  lastLoginAt DateTime?
  /// When the grant was withdrawn, or NULL while it is live. Revoking keeps the
  /// row so the audit trail survives the decision — and so re-granting the same
  /// address does not silently inherit the old `addedAt`.
  revokedAt   DateTime?
}

/// The grand admin's password, stored as a hash.
///
/// Until this existed the grand admin *was* the deployment secret in the environment —
/// not a row, so the ability to grant access could not be given away from a web form.
/// This row keeps that property while letting the password be changed without a redeploy.
///
/// `ADMIN_SECRET` remains the root credential and still signs in, which matters twice
/// over: the first owner session has to come from somewhere in order to set this row, and
/// a forgotten password must never mean being locked out of your own tournament.
///
/// One row, enforced by a fixed `id`. Two rows would be two passwords with no rule about
/// which wins, which is how a "change the password" feature turns into a back door.
///
/// The hash is peppered with a secret derived from `ADMIN_SECRET`, so this table alone is
/// not enough to attack it — see `src/lib/admin-credential.ts`.
model AdminCredential {
  /// Always "owner". A single-row table, made explicit rather than implied.
  id           String   @id @default("owner")
  /// `scrypt-pepper:<salt>:<digest>`. Never the password.
  passwordHash String
  /// When it was last set, so the console can say how old the credential is.
  updatedAt    DateTime @updatedAt
  /// Which door it was set from, for the audit trail.
  updatedVia   String   @default("console")
}

/// A game's rulebook — the document teams must read before they can submit.
///
/// One per game, keyed by `gameId` exactly like `GameLogo`, because each title is
/// played by different rules and a team only ever needs the rules for the game it
/// entered. The bytes live here rather than on disk because Vercel's filesystem is
/// ephemeral — the same reason as the logos.
model Rulebook {
  gameId    String   @id
  mimeType  String
  size      Int
  bytes     Bytes
  /// What the organisers call this version, shown to teams next to the viewer.
  title     String   @default("")
  updatedAt DateTime @updatedAt
}
