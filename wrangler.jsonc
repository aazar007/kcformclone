{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ksucrownform",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
 "secrets": {
    "required": [
      "DATABASE_URL",
      "OTP_SECRET",
      "SMTP_OTP_FROM",
      "SMTP_OTP_HOST",
      "SMTP_OTP_PASS",
      "SMTP_OTP_PORT",
      "SMTP_OTP_USER"
    ]
  },
 "hyperdrive": [
    {
      "binding": "DATABASE_URL",
      "id": "1ae455bb1fdb475693dc2b5fbe8625d1"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "WORKER_SELF_REFERENCE",
        "type": "service",
        "service": "ksucrownform",
        "environment": "production"
      }
    ]
  },


}
// hi
