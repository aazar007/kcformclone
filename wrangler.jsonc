{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ksucrownform",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
 "secrets_store_secrets": [
    {
      "binding": "DATABASE_URL",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "DATABASE_URL"
    },
    {
      "binding": "OTP_SECRET",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "OTP_SECRET"
    },
    {
      "binding": "SMTP_OTP_FROM",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "SMTP_OTP_FROM"
    },
    {
      "binding": "SMTP_OTP_HOST",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "SMTP_OTP_HOST"
    },
    {
      "binding": "SMTP_OTP_PASS",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "SMTP_OTP_PASS"
    },
    {
      "binding": "SMTP_OTP_PORT",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "SMTP_OTP_PORT"
    },
    {
      "binding": "SMTP_OTP_USER",
      "store_id": "9706271bba9b4abf9d759dc625154617",
      "secret_name": "SMTP_OTP_USER"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
"unsafe": {
  "bindings": [
    {
      "name": "WORKER_SELF_REFERENCE",
      "type": "service",
      "service": "ksucrownform",
      "environment": "production"
    }
  ]
}


}
// hi
