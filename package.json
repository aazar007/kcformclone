{
  "name": "ksucrownform",
  "version": "1.0.0",
  "private": true,
  "description": "KSU Crown esports championship — team registration form",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npm run prisma7 -- generate && prisma contract emit && next build && opennextjs-cloudflare build"
    "start": "next start -p 3001",
    "postinstall": "npm run prisma7 -- generate && prisma contract emit",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/self-test.ts",
    "check": "tsx scripts/check-stack.ts",
    "admin:hash": "tsx scripts/hash-admin-secret.ts",
    "email:preview": "tsx scripts/preview-email.ts",
    "prisma7": "node node_modules/prisma7/build/index.js --config prisma7.config.ts",
    "contract:emit": "prisma contract emit",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "db:migrate": "npm run prisma7 -- migrate dev && npm run contract:emit",
    "db:deploy": "npm run prisma7 -- migrate deploy",
    "db:studio": "npm run prisma7 -- studio",
    "sheet:export": "tsx scripts/export-sheet.ts",
    "sheet:inspect": "tsx scripts/inspect-sheet.ts",
    "build:cloud": "npm run prisma7 -- generate && prisma contract emit && next build"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "alchemy": "2.0.0-beta.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.1",
    "effect": "4.0.3",
    "lucide-react": "^1.46.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@prisma/composer": "0.32.0",
    "@prisma/composer-prisma-cloud": "0.32.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "8.0.0-rc.24",
    "prisma7": "npm:prisma@^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5",
    "hono": "^4.13.13",
    "@hono/node-server": "^1.19.17",
    "valibot": "^1.5.0",
    "lodash": "^4.18.1",
    "@prisma/cli-engine": "$@prisma/cli-engine",
    "effect": "4.0.3",
    "@effect/vitest": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/sql-pg": "4.0.3",
    "@effect/sql-mysql2": "4.0.3",
    "@prisma/config@^7.10.1": {
      "effect": "3.20.0"
    }
  }
}
