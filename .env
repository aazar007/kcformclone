# ---------------------------------------------------------------------------
# OTP email verification
# ---------------------------------------------------------------------------
# Every roster member must confirm their address with a 6-digit code. OTP_SECRET
# signs the short-lived proof the browser carries back to the API — generate it
# with: openssl rand -base64 32
OTP_SECRET="openssl rand -base64 32"

# SMTP is how mail is delivered. There are TWO channels, because a verification
# code and a confirmation email have different needs and fail independently:
#
#   * verification codes ("otp")  — worthless if slow or filtered, so usually a
#     transactional provider built for automated sending.
#   * confirmations                — a record the captain may reply to, so often
#     the organisers' own mailbox.
#
# Each channel reads SMTP_OTP_* / SMTP_CONFIRMATION_* first, then falls back to
# the shared SMTP_* below. So setting only SMTP_* (as this file does) keeps both
# channels on one account. Override just the one you want to move, e.g. leave
# SMTP_* for confirmations and add:
#
SMTP_OTP_HOST="smtp.gmail.com"
SMTP_OTP_PORT="587"
SMTP_OTP_USER="xxjtbxx1@gmail.com"
SMTP_OTP_PASS="ztyu qonu kmtl yhvv"
SMTP_OTP_FROM="KSU Crown"
#
# Per channel you can set: _HOST _PORT _SECURE _USER _PASS _FROM _REPLY_TO
# With none of this set, messages are written to the server log instead
# (development only — refused in production).
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="ht@mbridgeht.com"
SMTP_PASS="bUPG b6Sr 5XgE"
SMTP_FROM="KSU Crown"

# Where replies go. Defaults to SMTP_USER when blank. Can be overridden per
# channel with SMTP_OTP_REPLY_TO / SMTP_CONFIRMATION_REPLY_TO.
MAIL_REPLY_TO=""

# ---------------------------------------------------------------------------
# Public address of the site
# ---------------------------------------------------------------------------
# Used for the absolute links and images in emails, which cannot be relative.
# Leave blank and the app uses whatever host served the request — correct for
# local development. SET THIS to the real domain in production, so a preview
# deployment never emails links pointing at itself.
APP_URL=""